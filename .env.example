# -- LTV warehouse configuration --
LTV_DATABASE_URL = postgresql+psycopg://ltv:ltv@localhost:5432/ltv
LTV_LOG_LEVEL = INFO
LTV_LOG_JSON = false

# Path to the UCI "Online Retail II" workbook (sheets: 'Year 2009-2010', 'Year 2010-2011').
# If absent, a reproducible synthetic dataset with the same schema is generated automatically.
LTV_RAW_PATH=data/raw/online_retail_II.xlsx